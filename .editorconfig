# Editor formatting for Chikku Launcher. Kotlin follows the official Kotlin coding conventions
# (gradle.properties sets kotlin.code.style=official). The ktlint_* keys are read by the ktlint CLI
# used in CI; there is no ktlint Gradle plugin.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = intellij_idea
# Android Studio's formatter does not reflow signatures; keep multi-line parameter lists legal.
ktlint_standard_class-signature = disabled
ktlint_standard_function-signature = disabled
# Trailing commas are allowed but not required, matching Android Studio's default formatter.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, ^

[*.xml]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[{gradlew,*.sh}]
indent_size = 4

[*.bat]
end_of_line = crlf
