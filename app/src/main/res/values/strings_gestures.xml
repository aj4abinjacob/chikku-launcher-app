    <!-- Accessibility service (shown in system settings). -->
    <string name="gestures_accessibility_service_label">Chikku gestures</string>
    <string name="gestures_accessibility_service_summary">Lets Chikku home gestures lock the screen and open recent apps</string>
    <string name="gestures_accessibility_service_description">Used only when you bind a Chikku home or icon gesture to “Lock screen”, “Recent apps”, or (if the device blocks the normal way) the notification shade or quick settings. The service receives no accessibility events, cannot read screen content, and stores or sends nothing. Recent apps opened this way do not use the system gesture-navigation animation.</string>

