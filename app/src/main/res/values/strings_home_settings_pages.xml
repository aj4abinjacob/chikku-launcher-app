    <string name="settings_home_locked_main_info">While the layout is locked, new apps aren’t placed on the home screen, and the grid size, widget overlap and pages can’t change.</string>
    <string name="settings_home_grid_locked_info">Unlock the home screen layout to change the grid size or move hidden items.</string>
    <string name="settings_home_header_edge_space">Space at the screen edges</string>
    <string name="settings_home_grid_spacing_info">Keeps apps away from the edges of the home screen. The space between apps follows from the number of rows and columns.</string>
    <string name="settings_home_labels_off_info">Labels are hidden. Turn on Show labels to change their size, font and color.</string>
    <string name="settings_home_widget_padding_info">Adds an inset inside each widget’s cell, so widgets don’t touch each other.</string>
    <string name="settings_home_widget_overlap_locked_info">Unlock the home screen layout to let widgets overlap other items.</string>
    <string name="settings_home_add_page_locked_info">Unlock the home screen layout to add pages.</string>
    <string name="settings_home_loop_pages">Loop pages</string>
    <string name="settings_home_loop_pages_keywords">infinite scroll wrap around</string>
    <string name="settings_home_discover_off_info">Turn on to open the Google Discover feed by swiping outwards from the first page.</string>
