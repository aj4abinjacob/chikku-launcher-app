<resources>
    <!-- Settings › Dock: main page and its sub-pages -->
    <string name="settings_dock_off_info">Turn on the dock to keep favorite apps at the bottom of every home screen page. Apps you placed in it come back when you turn it on.</string>

    <string name="settings_dock_page_apps">Apps and pages</string>
    <plurals name="settings_dock_apps_count">
        <item quantity="one">%d app</item>
        <item quantity="other">%d apps</item>
    </plurals>
    <plurals name="settings_dock_pages_count">
        <item quantity="one">%d page</item>
        <item quantity="other">%d pages</item>
    </plurals>
    <string name="settings_dock_single_page_info">With more than one page you can swipe the dock sideways. Looping and reopening the last page are then available here.</string>

    <string name="settings_dock_page_icons">Icons and app names</string>
